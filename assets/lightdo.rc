#pragma code_page(65001)
#include <windows.h>
1 ICON "lightdo.ico"
1 RT_MANIFEST "lightdo.manifest"
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Yuan Haoran (Richard-Nido)\0"
   VALUE "FileDescription", "LightDo - Local glass todo\0"
   VALUE "FileVersion", "@VERSION@\0"
   VALUE "InternalName", "lightdo\0"
   VALUE "OriginalFilename", "lightdo.exe\0"
   VALUE "ProductName", "LightDo\0"
   VALUE "ProductVersion", "@VERSION@\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Yuan Haoran\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
